<?xml version="1.0" encoding="utf-8"?>
<!-- .NET 없이 도는 PB 12.1 용 OLE 컨트롤. Windows 7 SP1 이상, 32비트.
     빌드: nuget install Microsoft.Web.WebView2 -Version 1.0.4078.44 -OutputDirectory packages
           msbuild HwpxEditor.vcxproj /p:Configuration=Release /p:Platform=Win32 -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6B2E7C1A-3F4D-4E8B-9A51-2C7D0E9F1A10}</ProjectGuid>
    <Keyword>AtlProj</Keyword>
    <RootNamespace>HwpxEditor</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <WebView2Version>1.0.4078.44</WebView2Version>
    <WebView2Dir>$(MSBuildThisFileDirectory)packages\Microsoft.Web.WebView2.$(WebView2Version)\build\native\</WebView2Dir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseOfAtl>Static</UseOfAtl>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>HwpxEditor</TargetName>
    <TargetExt>.ocx</TargetExt>
    <OutDir>$(MSBuildThisFileDirectory)bin\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\</IntDir>
    <IgnoreImportLibrary>true</IgnoreImportLibrary>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;_USRDLL;_WIN32_WINNT=0x0601;WINVER=0x0601;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(IntDir);$(WebView2Dir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <Optimization>MaxSpeed</Optimization>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Midl>
      <OutputDirectory>$(IntDir)</OutputDirectory>
      <HeaderFileName>HwpxEditor_i.h</HeaderFileName>
      <InterfaceIdentifierFileName>HwpxEditor_i.c</InterfaceIdentifierFileName>
      <TypeLibraryName>$(IntDir)HwpxEditor.tlb</TypeLibraryName>
      <TargetEnvironment>Win32</TargetEnvironment>
      <ValidateAllParameters>true</ValidateAllParameters>
    </Midl>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>HwpxEditor.def</ModuleDefinitionFile>
      <AdditionalDependencies>$(WebView2Dir)x86\WebView2LoaderStatic.lib;version.lib;crypt32.lib;winspool.lib;shlwapi.lib;comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <RegisterOutput>false</RegisterOutput>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="HwpxEditor.cpp" />
    <ClCompile Include="$(IntDir)HwpxEditor_i.c" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="HwpxEditor.idl" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="HwpxEditor.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="HwpxEditor.rgs" />
    <None Include="HwpxEditor.def" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
